model DigestPreference {
  id               String          @id @default(uuid())
  userId           String          @unique @map("user_id")
  frequency        DigestFrequency @default(DAILY)
  enabled          Boolean         @default(true)
  unsubscribeToken String          @unique @map("unsubscribe_token")
  lastSentAt       DateTime?       @map("last_sent_at")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([enabled, frequency])
  @@map("digest_preferences")
}

model PropertyAgent {
  id             String   @id @default(uuid())
  propertyId     String   @map("property_id")
  agentId        String   @map("agent_id")
  commissionRate Decimal  @default(0.03) @map("commission_rate")
  contactPhone   String?  @map("contact_phone")
  contactEmail   String?  @map("contact_email")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  agent    User     @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([propertyId, agentId])
  @@map("property_agents")
}

model Commission {
  id            String            @id @default(uuid())
  transactionId String            @map("transaction_id")
  agentId       String            @map("agent_id")
  propertyId    String            @map("property_id")
  amount        Decimal           @map("amount")
  rate          Decimal           @map("rate")
  status        TransactionStatus @default(PENDING)
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  agent       User        @relation(fields: [agentId], references: [id], onDelete: Cascade)
  property    Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([transactionId, agentId])
  @@map("commissions")
}

model PropertyAmenity {
  id          String   @id @default(uuid())
  propertyId  String   @map("property_id")
  name        String
  amenityType String   @map("amenity_type")
  description String?
  isAvailable Boolean  @default(true) @map("is_available")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([amenityType])
  @@map("property_amenities")
}

// Property duplicate detection results
model PropertyDuplicate {
  id              String   @id @default(uuid())
  propertyId      String   @map("property_id")
  duplicateOfId   String?  @map("duplicate_of_id") // null if unknown match
  duplicateType    String   @map("duplicate_type") // ADDRESS, IMAGE, ADDRESS_AND_IMAGE
  confidenceScore Int      @default(0) @map("confidence_score") // 0-100
  evidence        Json?    @map("evidence") // match details
  isMerged          Boolean  @default(false) @map("is_merged")
  mergedIntoId      String?  @map("merged_into_id") // points to surviving property after merge
  flaggedForReview  Boolean  @default(false) @map("flagged_for_review")
  reviewNotes       String?  @map("review_notes")
  isResolved        Boolean  @default(false) @map("is_resolved")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  property    Property @relation("DuplicateProperty", fields: [propertyId], references: [id], onDelete: Cascade)
  duplicateOf Property? @relation("DuplicateTarget", fields: [duplicateOfId], references: [id], onDelete: SetNull)
  mergedInto  Property? @relation("MergedProperty", fields: [mergedIntoId], references: [id], onDelete: SetNull)

  @@index([propertyId])
  @@index([duplicateOfId])
  @@index([duplicateType])
  @@index([isMerged])
  @@map("property_duplicates")
}

// Transaction notes with visibility rules (#562)
model TransactionNote {
  id            String   @id @default(uuid())
  transactionId String   @map("transaction_id")
  authorId      String   @map("author_id")
  content       String   @db.Text
  isPublic      Boolean  @default(true) @map("is_public")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  author      User        @relation("TransactionNoteAuthor", fields: [authorId], references: [id])

  @@index([transactionId])
  @@index([authorId])
  @@map("transaction_notes")
 }
 
enum RsvpStatus {
  ATTENDING
  DECLINED
  MAYBE
}

model OpenHouse {
